.venv/
__pycache__/
.DS_Store
catboost_info/
*.pyc
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Run directories the notebooks write when executed.
_step5_demo/

# Agent run output: journals, transcripts and fitted models (100s of MB).
# The runners in `scripts/` reproduce them; findings go in HANDOFF/decisions.
_runs/

# Kaggle competition data — downloaded, not ours to redistribute.
# `house_prices/`: train.csv + test.csv from the house-prices-advanced-regression
# competition; `train_no_id.csv` is train.csv minus the Id column.
house_prices/
# `rossmann_store_sales/`: train.csv + test.csv + store.csv from the
# rossmann-store-sales competition. `train_joined.parquet` is built from them by
# `scripts/prep_rossmann.py` — regenerate it rather than looking for it here.
rossmann_store_sales/
# `seguro_driver_prediction/`: porto-seguro-safe-driver-prediction. 287MB, and no
# runner exists for it yet — it is a third dataset waiting to be used, not part of
# any finding recorded so far.
seguro_driver_prediction/
# `restaurant_visitor/`: recruit-restaurant-visitor-forecasting. Six CSVs plus the
# public leaderboard; `hpg_reserve.csv` alone is 126MB. `train_joined.parquet` and
# `test_joined.parquet` are built from them by `scripts/prep_restaurant.py` —
# regenerate them rather than looking for them here.
restaurant_visitor/

# Secrets — API keys live here and must never be committed.
.secrets/
.env
*.env
*.key
