# Copy this file to `config.env` and fill in your own key.
#   cp config.env.example config.env
#
# `config.env` is gitignored (matched by `*.env`); the real key is never
# committed. The harness reads REQUESTY_API_KEY from the environment first and
# falls back to this file — see `load_api_key` in
# src/tabular_agent/harness/agent.py.
#
# The key is a Requesty gateway key (https://router.requesty.ai). Each
# collaborator uses their own.
REQUESTY_API_KEY=
